<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon for "Add expense", which opens straight into the amount field. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutId="add_expense"
        android:shortcutLongLabel="@string/shortcut_add_long"
        android:shortcutShortLabel="@string/shortcut_add_short">
        <intent
            android:action="app.tripledger.ADD_EXPENSE"
            android:targetClass="app.tripledger.MainActivity"
            android:targetPackage="app.tripledger" />
    </shortcut>
</shortcuts>
