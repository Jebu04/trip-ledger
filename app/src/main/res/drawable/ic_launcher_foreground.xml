<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher foreground: gold suitcase and coin, converted from the 512x512 source SVG.
  The group scales the SVG coordinates by 0.2 and centres them on the 108dp canvas, which keeps
  the farthest point of the artwork about 32dp from the centre, inside the 33dp safe-zone radius.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.2"
        android:scaleY="0.2"
        android:translateX="2.8"
        android:translateY="2.8">
        <!-- body -->
        <path
            android:fillColor="#00000000"
            android:pathData="M164,192H348a28,28 0 0 1 28,28V340a28,28 0 0 1 -28,28H164a28,28 0 0 1 -28,-28V220a28,28 0 0 1 28,-28Z"
            android:strokeColor="#D9B26A"
            android:strokeWidth="14"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- handle -->
        <path
            android:fillColor="#00000000"
            android:pathData="M212,192V164a20,20 0 0 1 20,-20h48a20,20 0 0 1 20,20v28"
            android:strokeColor="#D9B26A"
            android:strokeWidth="14"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- coin -->
        <path
            android:fillColor="#D9B26A"
            android:pathData="M222,280a34,34 0 1 0 68,0a34,34 0 1 0 -68,0Z" />
    </group>
</vector>
